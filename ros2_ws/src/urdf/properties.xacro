<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">


                                <!-- Properties -->
    <!-- Chassis -->
    <xacro:property name="chassis_length" value="0.58"/>
    <xacro:property name="chassis_width" value="0.49"/>
    <xacro:property name="chassis_height" value="0.30"/>
    <xacro:property name="chassis_mass" value="15.0"/>
    <!-- Wheels -->
    <xacro:property name="wheel_offset_x" value="0.1"/>
    <xacro:property name="wheel_offset_y" value="0.238"/>
    <xacro:property name="wheel_offset_z" value="-0.025"/>
    <xacro:property name="wheel_thickness" value="0.045"/>
    <xacro:property name="wheel_radius" value="0.0738"/>
    <xacro:property name="wheel_mass" value="15.0"/>
    <!-- Front caster -->
    <xacro:property name="caster_front_radius" value="0.03"/>
    <xacro:property name="caster_front_mass" value="0.045"/>
    <xacro:property name="caster_front_offset_x" value="0.42"/>  <!-- front -->
    <xacro:property name="caster_front_offset_z" value="-0.035"/>


    <!-- Back caster -->
    <xacro:property name="caster_back_radius" value="0.03"/>
    <xacro:property name="caster_back_mass" value="0.045"/>
    <xacro:property name="caster_back_offset_x" value="0.09"/> <!-- back -->
    <xacro:property name="caster_back_offset_z" value="-0.035"/>




                                <!-- Colors -->    
    <material name="white">
        <color rgba="1 1 1 1"/>
    </material>


    <material name="red">
        <color rgba="1 0 0 1"/>
    </material>


    <material name="green">
        <color rgba="0 1 0 1"/>
    </material>


    <material name="blue">
        <color rgba="0 0 1 1"/>
    </material>


    <material name="black">
        <color rgba="0 0 0 1"/>
    </material>
</robot>