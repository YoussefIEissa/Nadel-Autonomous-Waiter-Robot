<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ================= FRONT CASTER ================= -->
    <link name="caster_front_link">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <sphere radius="${caster_front_radius}"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <sphere radius="${caster_front_radius}"/>
            </geometry>
        </collision>

        <xacro:inertial_sphere mass="${caster_front_mass}" radius="${caster_front_radius}">
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </xacro:inertial_sphere>
    </link>

    <joint name="caster_front_joint" type="fixed">
        <origin xyz="${caster_front_offset_x} 0.0 ${caster_front_offset_z}" rpy="0.0 0.0 0.0"/>
        <parent link="chassis_link"/>
        <child link="caster_front_link"/>
    </joint>

    <link name="caster_front_holder">
        <visual>
            <geometry>
                <cylinder radius="${caster_front_radius/2}" length="${caster_front_offset_z*2}"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>
    <joint name="caster_front_holder_joint" type="fixed">
        <origin xyz="${caster_front_offset_x} 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="chassis_link"/>
        <child link="caster_front_holder"/>
    </joint>

    <gazebo reference="caster_front_link">
        <mu1 value="0.001"/>
        <mu2 value="0.001"/>
    </gazebo>

    <!-- ================= BACK CASTER ================= -->
    <link name="caster_back_link">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <sphere radius="${caster_back_radius}"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <sphere radius="${caster_back_radius}"/>
            </geometry>
        </collision>

        <xacro:inertial_sphere mass="${caster_back_mass}" radius="${caster_back_radius}">
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </xacro:inertial_sphere>
    </link>

    <joint name="caster_back_joint" type="fixed">
        <origin xyz="${caster_back_offset_x} 0.0 ${caster_back_offset_z}" rpy="0.0 0.0 0.0"/>
        <parent link="chassis_link"/>
        <child link="caster_back_link"/>
    </joint>

    <link name="caster_back_holder">
        <visual>
            <geometry>
                <cylinder radius="${caster_back_radius/2}" length="${caster_back_offset_z*2}"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>
    <joint name="caster_back_holder_joint" type="fixed">
        <origin xyz="${caster_back_offset_x} 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="chassis_link"/>
        <child link="caster_back_holder"/>
    </joint>

    <gazebo reference="caster_back_link">
        <mu1 value="0.001"/>
        <mu2 value="0.001"/>
    </gazebo>

</robot>
